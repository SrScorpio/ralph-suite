{
  "name": "ralph-suite",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "1.6.5",
  "publisher": "ralph-suite",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "icon": "images/icon.png",
  "contributes": {
    "commands": [
      {
        "command": "ralph-suite.openKanban",
        "title": "Ralph: Open Board"
      },
      {
        "command": "ralph-suite.initProject",
        "title": "Ralph: Init Project"
      },
      {
        "command": "ralph-suite.runTask",
        "title": "Ralph: Run Next Task"
      },
      {
        "command": "ralph-suite.openSettings",
        "title": "Ralph: Settings"
      },
      {
        "command": "ralph-suite.showMenu",
        "title": "Ralph: Show Menu"
      },
      {
        "command": "ralph-suite.startRunner",
        "title": "Ralph: Start Runner"
      },
      {
        "command": "ralph-suite.stopRunner",
        "title": "Ralph: Stop Runner"
      },
      {
        "command": "ralph-suite.setupProject",
        "title": "Ralph: Setup Project (AGENTS.md + plans/)"
      }
    ],
    "keybindings": [
      {
        "command": "ralph-suite.openKanban",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "ralph-suite.openKanban"
        },
        {
          "command": "ralph-suite.initProject"
        },
        {
          "command": "ralph-suite.runTask"
        },
        {
          "command": "ralph-suite.openSettings"
        }
      ],
      "editor/context": [
        {
          "command": "ralph-suite.openKanban",
          "when": "resourceFilename == prd.json",
          "group": "ralph"
        }
      ]
    },
    "configuration": {
      "title": "Ralph Suite",
      "properties": {
        "ralph-suite.engine": {
          "type": "string",
          "enum": [
            "copilot",
            "claude",
            "opencode"
          ],
          "default": "copilot",
          "description": "%config.engine.description%"
        },
        "ralph-suite.maxLoops": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 50,
          "description": "%config.maxLoops.description%"
        },
        "ralph-suite.autoRun": {
          "type": "boolean",
          "default": false,
          "description": "%config.autoRun.description%"
        },
        "ralph-suite.freshContext": {
          "type": "boolean",
          "default": true,
          "description": "%config.freshContext.description%"
        },
        "ralph-suite.prdPath": {
          "type": "string",
          "default": "prd.json",
          "description": "%config.prdPath.description%"
        },
        "ralph-suite.memoriesPath": {
          "type": "string",
          "default": ".agent/memories.md",
          "description": "%config.memoriesPath.description%"
        },
        "ralph-suite.guardrails": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "Never modify prd.json",
            "Never delete files without confirmation",
            "Always include tests for new features",
            "Task states must be exactly: todo | inprogress | completed | blocked \u2014 never mix or invent states",
            "When a task is finished, write the completion signal and wait for instructions \u2014 do not generate extra questions unless explicitly part of the task",
            "Always read .agent/memories.md before starting any task to load project context",
            "Never commit secrets, API keys, tokens or passwords \u2014 use environment variables",
            "Always validate and sanitize user inputs \u2014 never trust raw input",
            "Run existing tests before marking a task as completed \u2014 do not break passing tests",
            "Security checkpoints required for: authentication changes, file deletions, DB schema changes, dependency upgrades",
            "All new code must follow the conventions already present in the codebase \u2014 check existing patterns before creating new ones",
            "Log important decisions and architectural choices in .agent/memories.md",
            "Never use placeholders or TODO comments in production code \u2014 implement or leave existing code",
            "If blocked, write a clear explanation in the note signal \u2014 do not silently timeout"
          ],
          "description": "%config.guardrails.description%"
        },
        "ralph-suite.boundaries": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.boundaries.description%"
        },
        "ralph-suite.taskTimeoutMs": {
          "type": "number",
          "default": 600000,
          "minimum": 30000,
          "description": "%config.taskTimeoutMs.description%"
        },
        "ralph-suite.taskRetries": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 5,
          "description": "%config.taskRetries.description%"
        },
        "ralph-suite.minWaitMs": {
          "type": "number",
          "default": 15000,
          "minimum": 0,
          "description": "%config.minWaitMs.description%"
        },
        "ralph-suite.pollIntervalMs": {
          "type": "number",
          "default": 5000,
          "minimum": 1000,
          "description": "%config.pollIntervalMs.description%"
        },
        "ralph-suite.agentRole": {
          "type": "string",
          "default": "Senior Software Engineer",
          "description": "%config.agentRole.description%"
        },
        "ralph-suite.agentStack": {
          "type": "string",
          "default": "",
          "description": "%config.agentStack.description%"
        },
        "ralph-suite.agentProject": {
          "type": "string",
          "default": "",
          "description": "%config.agentProject.description%"
        },
        "ralph-suite.agentCheckpoints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "Delete files or directories",
            "Modify database schemas or migrations",
            "Change authentication or security configuration",
            "Install or upgrade major dependencies",
            "Refactor more than 500 lines of code",
            "Change architecture documented in plans/"
          ],
          "description": "%config.agentCheckpoints.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.4.0"
  }
}